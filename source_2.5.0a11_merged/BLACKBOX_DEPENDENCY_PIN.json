{
  "architecture": "single-installed-blackbox-authority",
  "blackbox_distribution": "bbx1-iteration-wallet-plugin",
  "blackbox_version": "0.6.0a4",
  "client_schema": "bbx1-client/1",
  "core_package_owner": "bbx1-iteration-wallet-plugin",
  "wallet_adapter_package": "iteration_wallet_blackbox",
  "wallet_adapter_owner": "iteration-wallet",
  "wallet_wheel_contains_blackbox_core": false,
