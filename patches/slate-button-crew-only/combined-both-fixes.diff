+def test_slate_launcher_is_for_crew_and_the_slate_s_own_people(floor):
+    c,_=floor
+    flag=lambda user,role: c.get('/api/studio/slate',headers=headers(user,role)).json()['floor_crew']
+    # No production open: crew and up, and anyone who may open one.
+    assert [flag('m','viewer'),flag('g','guest'),flag('f','friend')]==[False,False,False]
+    assert [flag('c','crew'),flag('s','security'),flag('d','mod'),flag('a','admin'),flag('o','owner')]==[True]*5
+    post(c,'create');post(c,'delegate',{'editors':['assistant']})
+    post(c,'departments',{'departments':{'Camera':'cam','Cast':'lead'}})
+    # An open production adds the people its slate names, whatever their role,
+    # performers included once the director puts them on the roll call.
+    assert flag('assistant','viewer') and flag('cam','viewer') and flag('lead','viewer')
+    assert not flag('m','viewer')
+    post(c,'end')
+    assert not flag('cam','viewer') and not flag('lead','viewer')
+
+
