+def floor_crew(slate, identity) -> bool:
+    """Whether this caller gets the floor's slate launcher button.
+
+    Crew and up in PubCast's room roles (the same rank the studio, control room
+    and director rooms require), anyone allowed to open a production, and anyone
+    the active slate itself names: its director, delegated editors and the
+    accounts assigned a department check-in. Performers are reached that way:
+    the director lists them on the roll call ("Cast = account ID"), because
+    sign-in has no performer role. Everyone else still sees the floor
+    whenever the director shows it on every screen; this only decides the button.
+    """
+    from modules.chat_rooms import ROLE_RANK
+    role = str(identity.get('role') or 'guest')
+    if ROLE_RANK.get(role, -1) >= ROLE_RANK['crew'] or role_gte(role, 'mod'):
+        return True
+    if not slate or slate.get('phase') == 'ended':
+        return False
+    user_id = identity.get('user_id')
+    return (user_id == slate.get('director_id') or user_id in slate.get('editors', ())
+            or any(entry.get('user_id') == user_id for entry in slate.get('departments', {}).values()))
+
